# Hand-written build.ninja for cve.
# Four variants: clang-native, gcc-vector, clang-portable, gcc-portable.

ninja_required_version = 1.10

clang  = /opt/homebrew/opt/llvm/bin/clang++
gcc    = /opt/homebrew/bin/g++-15
ccache = /opt/homebrew/bin/ccache

cxxflags  = -std=c++20 -O2 -g -Wall -Wextra -Wpedantic -Iinclude

rule cxx_clang
  command = $ccache $clang $cxxflags $extra -MD -MF $out.d -c $in -o $out
  description = CXX[clang] $out
  depfile = $out.d
  deps = gcc

rule link_clang
  command = $clang -o $out $in
  description = LINK[clang] $out

rule cxx_gcc
  command = $ccache $gcc $cxxflags $extra -MD -MF $out.d -c $in -o $out
  description = CXX[gcc] $out
  depfile = $out.d
  deps = gcc

rule link_gcc
  command = $gcc -o $out $in
  description = LINK[gcc] $out

rule run
  command = $in && touch $out
  description = RUN $in

# ----- clang-native (true ext_vector_type) ----------------------------------
build out/clang-native/test_arith.o: cxx_clang tests/test_arith.cc
build out/clang-native/test_arith:   link_clang out/clang-native/test_arith.o
build out/clang-native/test_arith.ok: run out/clang-native/test_arith

# ----- gcc-vector (struct wrapping vector_size) -----------------------------
build out/gcc-vector/test_arith.o: cxx_gcc tests/test_arith.cc
build out/gcc-vector/test_arith:   link_gcc out/gcc-vector/test_arith.o
build out/gcc-vector/test_arith.ok: run out/gcc-vector/test_arith

# ----- clang-portable (CVE_FORCE_PORTABLE under clang) ----------------------
build out/clang-portable/test_arith.o: cxx_clang tests/test_arith.cc
  extra = -DCVE_FORCE_PORTABLE
build out/clang-portable/test_arith:   link_clang out/clang-portable/test_arith.o
build out/clang-portable/test_arith.ok: run out/clang-portable/test_arith

# ----- gcc-portable (CVE_FORCE_PORTABLE under gcc) --------------------------
build out/gcc-portable/test_arith.o: cxx_gcc tests/test_arith.cc
  extra = -DCVE_FORCE_PORTABLE
build out/gcc-portable/test_arith:   link_gcc out/gcc-portable/test_arith.o
build out/gcc-portable/test_arith.ok: run out/gcc-portable/test_arith

# ----- swizzle test (Phase 2) -----------------------------------------------
build out/clang-native/test_swizzle.o: cxx_clang tests/test_swizzle.cc
build out/clang-native/test_swizzle:   link_clang out/clang-native/test_swizzle.o
build out/clang-native/test_swizzle.ok: run out/clang-native/test_swizzle

build out/gcc-vector/test_swizzle.o: cxx_gcc tests/test_swizzle.cc
build out/gcc-vector/test_swizzle:   link_gcc out/gcc-vector/test_swizzle.o
build out/gcc-vector/test_swizzle.ok: run out/gcc-vector/test_swizzle

build out/clang-portable/test_swizzle.o: cxx_clang tests/test_swizzle.cc
  extra = -DCVE_FORCE_PORTABLE
build out/clang-portable/test_swizzle:   link_clang out/clang-portable/test_swizzle.o
build out/clang-portable/test_swizzle.ok: run out/clang-portable/test_swizzle

build out/gcc-portable/test_swizzle.o: cxx_gcc tests/test_swizzle.cc
  extra = -DCVE_FORCE_PORTABLE
build out/gcc-portable/test_swizzle:   link_gcc out/gcc-portable/test_swizzle.o
build out/gcc-portable/test_swizzle.ok: run out/gcc-portable/test_swizzle

# ----- types test (Phase 3) -------------------------------------------------
build out/clang-native/test_types.o: cxx_clang tests/test_types.cc
build out/clang-native/test_types:   link_clang out/clang-native/test_types.o
build out/clang-native/test_types.ok: run out/clang-native/test_types

build out/gcc-vector/test_types.o: cxx_gcc tests/test_types.cc
build out/gcc-vector/test_types:   link_gcc out/gcc-vector/test_types.o
build out/gcc-vector/test_types.ok: run out/gcc-vector/test_types

build out/clang-portable/test_types.o: cxx_clang tests/test_types.cc
  extra = -DCVE_FORCE_PORTABLE
build out/clang-portable/test_types:   link_clang out/clang-portable/test_types.o
build out/clang-portable/test_types.ok: run out/clang-portable/test_types

build out/gcc-portable/test_types.o: cxx_gcc tests/test_types.cc
  extra = -DCVE_FORCE_PORTABLE
build out/gcc-portable/test_types:   link_gcc out/gcc-portable/test_types.o
build out/gcc-portable/test_types.ok: run out/gcc-portable/test_types

# ----- shuffle test (Phase 4) -----------------------------------------------
build out/clang-native/test_shuffle.o: cxx_clang tests/test_shuffle.cc
build out/clang-native/test_shuffle:   link_clang out/clang-native/test_shuffle.o
build out/clang-native/test_shuffle.ok: run out/clang-native/test_shuffle

build out/gcc-vector/test_shuffle.o: cxx_gcc tests/test_shuffle.cc
build out/gcc-vector/test_shuffle:   link_gcc out/gcc-vector/test_shuffle.o
build out/gcc-vector/test_shuffle.ok: run out/gcc-vector/test_shuffle

build out/clang-portable/test_shuffle.o: cxx_clang tests/test_shuffle.cc
  extra = -DCVE_FORCE_PORTABLE
build out/clang-portable/test_shuffle:   link_clang out/clang-portable/test_shuffle.o
build out/clang-portable/test_shuffle.ok: run out/clang-portable/test_shuffle

build out/gcc-portable/test_shuffle.o: cxx_gcc tests/test_shuffle.cc
  extra = -DCVE_FORCE_PORTABLE
build out/gcc-portable/test_shuffle:   link_gcc out/gcc-portable/test_shuffle.o
build out/gcc-portable/test_shuffle.ok: run out/gcc-portable/test_shuffle

# ----- aggregates -----------------------------------------------------------
build all: phony $
    out/clang-native/test_arith    out/clang-native/test_swizzle    out/clang-native/test_types    out/clang-native/test_shuffle $
    out/gcc-vector/test_arith      out/gcc-vector/test_swizzle      out/gcc-vector/test_types      out/gcc-vector/test_shuffle $
    out/clang-portable/test_arith  out/clang-portable/test_swizzle  out/clang-portable/test_types  out/clang-portable/test_shuffle $
    out/gcc-portable/test_arith    out/gcc-portable/test_swizzle    out/gcc-portable/test_types    out/gcc-portable/test_shuffle

build test: phony $
    out/clang-native/test_arith.ok    out/clang-native/test_swizzle.ok    out/clang-native/test_types.ok    out/clang-native/test_shuffle.ok $
    out/gcc-vector/test_arith.ok      out/gcc-vector/test_swizzle.ok      out/gcc-vector/test_types.ok      out/gcc-vector/test_shuffle.ok $
    out/clang-portable/test_arith.ok  out/clang-portable/test_swizzle.ok  out/clang-portable/test_types.ok  out/clang-portable/test_shuffle.ok $
    out/gcc-portable/test_arith.ok    out/gcc-portable/test_swizzle.ok    out/gcc-portable/test_types.ok    out/gcc-portable/test_shuffle.ok

default test
