builddir = out

clang  = /opt/homebrew/opt/llvm/bin/clang++
gcc    = /opt/homebrew/bin/g++-15
ccache = /opt/homebrew/bin/ccache

cxxflags     = -std=c++20 -O1 -g -Werror
clang_warns  = -Weverything $
    -Wno-c++98-compat $
    -Wno-c++98-compat-pedantic $
    -Wno-pre-c++14-compat $
    -Wno-pre-c++17-compat $
    -Wno-pre-c++20-compat $
    -Wno-pre-c++20-compat-pedantic
gcc_warns    = -Wall -Wextra -Wpedantic

rule cxx_clang
  command = $ccache $clang $cxxflags $clang_warns $extra -MD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps    = gcc

rule link_clang
  command = $clang $in -o $out

rule cxx_gcc
  command = $ccache $gcc $cxxflags $gcc_warns $extra -MD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps    = gcc

rule link_gcc
  command = $gcc $in -o $out

rule run
  command = ./$in > $out

rule codegen_clang
  command = $clang -std=c++20 -O2 -S $in -o - | python3 codegen/scrub.py > $out

rule codegen_gcc
  command = $gcc -std=c++20 -O2 -S $in -o - | python3 codegen/scrub.py > $out

rule diff
  command = diff -u $golden $in && touch $out

build out/clang/test_arith.o: cxx_clang tests/test_arith.cc
build out/clang/test_arith:   link_clang out/clang/test_arith.o
build out/clang/test_arith.ok: run out/clang/test_arith

build out/gcc/test_arith.o: cxx_gcc tests/test_arith.cc
build out/gcc/test_arith:   link_gcc out/gcc/test_arith.o
build out/gcc/test_arith.ok: run out/gcc/test_arith

build out/clang/test_swizzle.o: cxx_clang tests/test_swizzle.cc
build out/clang/test_swizzle:   link_clang out/clang/test_swizzle.o
build out/clang/test_swizzle.ok: run out/clang/test_swizzle

build out/gcc/test_swizzle.o: cxx_gcc tests/test_swizzle.cc
build out/gcc/test_swizzle:   link_gcc out/gcc/test_swizzle.o
build out/gcc/test_swizzle.ok: run out/gcc/test_swizzle

build out/clang/test_types.o: cxx_clang tests/test_types.cc
build out/clang/test_types:   link_clang out/clang/test_types.o
build out/clang/test_types.ok: run out/clang/test_types

build out/gcc/test_types.o: cxx_gcc tests/test_types.cc
build out/gcc/test_types:   link_gcc out/gcc/test_types.o
build out/gcc/test_types.ok: run out/gcc/test_types

build out/clang/test_shuffle.o: cxx_clang tests/test_shuffle.cc
build out/clang/test_shuffle:   link_clang out/clang/test_shuffle.o
build out/clang/test_shuffle.ok: run out/clang/test_shuffle

build out/gcc/test_shuffle.o: cxx_gcc tests/test_shuffle.cc
build out/gcc/test_shuffle:   link_gcc out/gcc/test_shuffle.o
build out/gcc/test_shuffle.ok: run out/gcc/test_shuffle

build out/clang/test_loadstore.o: cxx_clang tests/test_loadstore.cc
build out/clang/test_loadstore:   link_clang out/clang/test_loadstore.o
build out/clang/test_loadstore.ok: run out/clang/test_loadstore

build out/gcc/test_loadstore.o: cxx_gcc tests/test_loadstore.cc
build out/gcc/test_loadstore:   link_gcc out/gcc/test_loadstore.o
build out/gcc/test_loadstore.ok: run out/gcc/test_loadstore

build out/codegen/clang/fma.s: codegen_clang codegen/fma.cc
build out/codegen/clang/fma.ok: diff out/codegen/clang/fma.s
  golden = codegen/clang/fma.s

build out/codegen/clang/loop_sum.s: codegen_clang codegen/loop_sum.cc
build out/codegen/clang/loop_sum.ok: diff out/codegen/clang/loop_sum.s
  golden = codegen/clang/loop_sum.s

build out/codegen/gcc/fma.s: codegen_gcc codegen/fma.cc
build out/codegen/gcc/fma.ok: diff out/codegen/gcc/fma.s
  golden = codegen/gcc/fma.s

build out/codegen/gcc/loop_sum.s: codegen_gcc codegen/loop_sum.cc
build out/codegen/gcc/loop_sum.ok: diff out/codegen/gcc/loop_sum.s
  golden = codegen/gcc/loop_sum.s
